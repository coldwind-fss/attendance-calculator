HR_DATA_DIR=/var/lib/attendance-calculator
HR_ADMIN_USERNAME=attendance-admin
HR_ADMIN_PASSWORD=replace-before-install

# A loopback-only service can be reached over SSH. For HTTPS ingress, remove
# HR_LOCAL_DEVELOPMENT and set HR_PUBLIC_BASE_URL to the external HTTPS origin.
HR_LOCAL_DEVELOPMENT=1
HR_PUBLIC_BASE_URL=http://127.0.0.1:18405

# Provision these files separately from the release archive.
# HR_FULLTIME_TEMPLATE=/etc/attendance-calculator/template_fulltime.xlsx
# HR_PERFORMANCE_TEMPLATE_DIR=/etc/attendance-calculator/performance-templates
# HR_PERFORMANCE_LINK_SECRET=...
HR_ENABLE_PERFORMANCE_COMPAT=1
HR_ENABLE_DINGTALK_DELIVERY=0
HR_ENABLE_PERFORMANCE_EXTERNAL=0
